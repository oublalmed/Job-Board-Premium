# Copy to .env.local for local development (gitignored, never commit it).
# Vite only exposes variables prefixed VITE_ to client code — see
# https://vite.dev/guide/env-and-mode.html.

# Bare origin of the backend API — deliberately NOT including /api/v1.
# The generated OpenAPI schema's path keys already include the full
# registered route (NestJS's global prefix is set before the Swagger
# document is built, so every path in schema.d.ts starts with /api/v1
# itself) — apiClient calls use those full paths (e.g. '/api/v1/auth/login'),
# so baseUrl must be just the origin or requests would double up the prefix.
VITE_API_BASE_URL=http://localhost:3000
