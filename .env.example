# =============================================================================
# Job Board Premium - Environment Variables
# Copy to .env and fill in values. Never commit .env itself.
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
TZ=Africa/Casablanca

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=jobboard
DB_PASSWORD=changeme
DB_DATABASE=jobboard_dev
DB_SYNCHRONIZE=false
DB_LOGGING=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRATION=7d

# --- Storage (S3 / MinIO) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=jobboard
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# --- Business rules (overridable via settings table) ---
PROFILE_COMPLETENESS_THRESHOLD=70
INDEXATION_SCORE_THRESHOLD=40
INDEXATION_PERCENTILE_THRESHOLD=30
HIGHLIGHT_PERCENTILE_THRESHOLD=75
SCORE_VALIDITY_MONTHS=12
RETEST_COOLDOWN_DAYS=90
PASSWORD_MIN_LENGTH=10
MAX_CV_SIZE_BYTES=5242880

# --- Recruiter pricing (MAD HT) ---
PLAN_STARTER_PRICE=990
PLAN_STARTER_CONTACTS=15
PLAN_STARTER_OFFERS=1
PLAN_STARTER_USERS=1
PLAN_GROWTH_PRICE=2900
PLAN_GROWTH_CONTACTS=60
PLAN_GROWTH_OFFERS=5
PLAN_GROWTH_USERS=3
PLAN_SCALE_PRICE=6900
PLAN_SCALE_CONTACTS=200
PLAN_SCALE_OFFERS=20
PLAN_SCALE_USERS=10
CURRENCY=MAD
