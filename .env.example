# =============================================================================
# Talentiq - Environment Variables
# Copy to .env and fill in values. Never commit .env itself.
# =============================================================================

# --- App ---
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1
TZ=Africa/Casablanca
# The Vite dev server's origin (Front 0) — falls back to '*' if unset
# (see main.ts), which already works for local dev but is too permissive
# for a real environment.
CORS_ORIGIN=http://localhost:5173

# --- Database (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=jobboard
DB_PASSWORD=changeme
DB_DATABASE=jobboard_dev
# false is the only supported value outside a personal local database — see
# docs/adr/0002-schema-migration-governance.md. Schema changes go through
# `npm run migration:generate`/`migration:run`, never through synchronize,
# in any environment other than your own machine. Setting this to true
# locally is fine (disposable DB, no real data); it must never be true in
# CI, staging, or production.
DB_SYNCHRONIZE=false
DB_LOGGING=true

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
JWT_ACCESS_SECRET=change-this-access-secret-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRATION=7d

# --- Storage (S3 / MinIO) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=jobboard
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true

# --- Scoring webhook ---
# HMAC-SHA256 shared secret used to verify POST /assessments/webhook calls.
# A missing/empty value makes every webhook call fail closed (rejected).
SCORING_WEBHOOK_SECRET=change-this-scoring-webhook-secret

# --- Payment (Stripe) ---
# Test-mode keys from the Stripe dashboard. STRIPE_WEBHOOK_SECRET verifies
# POST /webhooks/payment (from `stripe listen` in dev, or the dashboard's
# webhook endpoint secret elsewhere) — same fail-closed rule as scoring.
STRIPE_SECRET_KEY=sk_test_change_this
STRIPE_WEBHOOK_SECRET=whsec_change_this

# --- Legal invoice issuer identity (Lot 6C) ---
# The platform's own legal identity as the invoice issuer — printed on
# every invoice PDF alongside the buyer's ICE. Not a companies table row.
INVOICE_ISSUER_NAME=Talentiq SARL
INVOICE_ISSUER_ICE=000000000000000
INVOICE_ISSUER_ADDRESS=Casablanca, Maroc

# --- Business rules (overridable via settings table) ---
PROFILE_COMPLETENESS_THRESHOLD=70
INDEXATION_SCORE_THRESHOLD=40
INDEXATION_PERCENTILE_THRESHOLD=30
HIGHLIGHT_PERCENTILE_THRESHOLD=75
SCORE_VALIDITY_MONTHS=12
RETEST_COOLDOWN_DAYS=90
PASSWORD_MIN_LENGTH=10
MAX_CV_SIZE_BYTES=5242880
TRIAL_DURATION_DAYS=14
# Days a PAST_DUE subscription keeps full access before it's restricted
# (Lot 6D, US-BILL-04) — the grace window, not Stripe's own retry count.
SUBSCRIPTION_GRACE_PERIOD_DAYS=7
# When the daily cooldown-expiry notification sweep runs (Lot 7, EF-REM-03).
COOLDOWN_SWEEP_CRON=0 3 * * *
# Anti-spam window for "recruiter viewed your profile" notifications
# (Lot 7, EF-GROW-04) — repeated views within this window notify once.
PROFILE_VIEW_NOTIFICATION_COOLDOWN_HOURS=24

# --- Recruiter pricing (MAD HT) ---
PLAN_STARTER_PRICE=990
PLAN_STARTER_CONTACTS=15
PLAN_STARTER_OFFERS=1
PLAN_STARTER_USERS=1
PLAN_GROWTH_PRICE=2900
PLAN_GROWTH_CONTACTS=60
PLAN_GROWTH_OFFERS=5
PLAN_GROWTH_USERS=3
PLAN_SCALE_PRICE=6900
PLAN_SCALE_CONTACTS=200
PLAN_SCALE_OFFERS=20
PLAN_SCALE_USERS=10
CURRENCY=MAD
