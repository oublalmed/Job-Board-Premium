# Copy to .env.demo and edit before deploying:  cp .env.demo.example .env.demo
# Used by:  docker compose --env-file .env.demo -f docker-compose.demo.yml up -d --build

# --- Secrets (CHANGE THESE — JWT secrets must be at least 16 characters) ---
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-01
JWT_REFRESH_SECRET=change-me-to-another-long-random-str
SCORING_WEBHOOK_SECRET=change-me-scoring-webhook-secret

# --- Database ---
DB_USERNAME=jobboard
DB_PASSWORD=change-me-strong-db-password
DB_DATABASE=jobboard_demo

# --- Object storage (MinIO) ---
MINIO_USER=minioadmin
MINIO_PASSWORD=change-me-strong-minio-password

# --- Host ports (only need changing if already in use on the VM) ---
DEMO_HTTP_PORT=8080
MAILPIT_UI_PORT=8025
