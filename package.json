{
  "name": "cobalt",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "load:k6": "k6 run test/load/k6-search.js",
    "typeorm": "ts-node -r tsconfig-paths/register -r ./scripts/resolve-js-as-ts.js ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- migration:generate -d src/database/data-source.ts",
    "migration:run": "npm run typeorm -- migration:run -d src/database/data-source.ts",
    "migration:revert": "npm run typeorm -- migration:revert -d src/database/data-source.ts",
    "seed": "ts-node -r tsconfig-paths/register -r ./scripts/resolve-js-as-ts.js src/database/seed.ts",
    "seed:testcases": "ts-node -r tsconfig-paths/register -r ./scripts/resolve-js-as-ts.js src/database/seed-testcases.ts",
    "make:admin": "ts-node -r tsconfig-paths/register -r ./scripts/resolve-js-as-ts.js src/database/make-admin.ts",
    "activate:admin": "ts-node -r tsconfig-paths/register -r ./scripts/resolve-js-as-ts.js src/database/activate-admin.ts"
  }
}
